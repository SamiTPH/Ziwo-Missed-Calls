ZIWO_INSTANCE=
ZIWO_USERNAME=
ZIWO_PASSWORD=
ZIWO_CANCEL_RESULTS=cancel
ZIWO_DISPLAY_TIMEZONE=Asia/Dubai
ZIWO_AGENT_CACHE_TTL_SECONDS=900

# Microsoft Graph app registration used to read the SharePoint Excel agent sheet.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# SharePoint/OneDrive Excel table that contains agent id/name/team columns.
# Example file path: /Shared Documents/Agents.xlsx
AGENT_SHEET_EXCEL_USER=
AGENT_SHEET_FILE_PATH=
AGENT_SHEET_TABLE_NAME=
AGENT_SHEET_ID_COLUMN=
AGENT_SHEET_NAME_COLUMN=
AGENT_SHEET_TEAM_COLUMN=
AGENT_SHEET_CACHE_TTL_SECONDS=900

# Microsoft Teams Workflows webhook notifications.
# Paste the matching Power Automate workflow URL into each variable.
TEAMS_WEBHOOK_URL_AFTER_SALES=
TEAMS_WEBHOOK_URL_PRESALES=
TEAMS_WEBHOOK_URL_CMR=
